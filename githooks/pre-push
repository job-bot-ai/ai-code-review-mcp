#!/usr/bin/env bash
# git pre-push hook, installed with core.hooksPath (install-githooks). For every ref git is about to push it allows
# the push only when `review-gate check-prepush` passes for the pushed commit: a finished OpenQodex review of exactly
# that commit that passed (or whose findings were accepted with `prepush-accept`), given the current punch list.
# Anything else blocks, review-gate failing in any way included. Not gated: deletes and tags. git runs this hook
# for `git push --dry-run` too and doesn't say it is one; telling would mean parsing the push's arguments, which
# this design avoids, so a dry run is checked like a push (it sends nothing either way). Tim's switch: REVIEW_GATE_PREPUSH=off in the environment, logged. The repo's own .git/hooks/pre-push (which
# core.hooksPath would otherwise switch off) still runs after the checks pass.
# Part of https://github.com/job-bot-ai/ai-code-review-mcp
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
gate="$here/../review-gate"
input="$(cat)"

if [ "${REVIEW_GATE_PREPUSH:-}" = off ]; then
  log="${XDG_STATE_HOME:-$HOME/.local/state}/review-gate/prepush-bypass.log"
  mkdir -p "$(dirname "$log")" && printf '%s\tgit-hook\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" \
    "$(printf '%s' "$input" | tr '\n' ' ' | cut -c1-300)" >>"$log"
  echo "review-gate: pre-push gate is OFF (REVIEW_GATE_PREPUSH=off); push not checked, logged to $log" >&2
else
  blocked=""
  while read -r lref lsha rref _; do
    [ -n "${lsha:-}" ] || continue
    case "$lsha" in *[!0]*) ;; *) continue ;; esac   # a delete: nothing is published
    case "$rref" in refs/tags/*) continue ;; esac   # a tag
    if ! sha="$(git rev-parse --verify -q "$lsha^{commit}")"; then
      blocked="$blocked  $lref -> $rref: not a commit
"; continue
    fi
    out="$(bash "$gate" check-prepush --rev "$sha" 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then
      [ -z "$out" ] || printf '%s\n' "$out" >&2   # accepted findings are announced, never hidden
    else
      blocked="$blocked  $lref -> $rref (${sha:0:12}): ${out:-review-gate exited $rc}
"
    fi
  done <<<"$input"
  if [ -n "$blocked" ]; then
    {
      echo "BLOCKED by the pre-push review gate: every pushed commit needs a finished, passing OpenQodex review of exactly"
      echo "that commit, given the current punch list."
      printf '%s' "$blocked"
      echo "Run \`bash $(printf '%q' "$gate") prepush\` on a clean tree at the commit you push, fix what it finds (or"
      echo "decline a finding with \`prepush-accept --reason ...\`), then push again. A review that did not finish never passes."
    } >&2
    exit 1
  fi
fi

own="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [ -x "$own" ] && [ "$(readlink -f "$own")" != "$(readlink -f "${BASH_SOURCE[0]}")" ]; then
  printf '%s\n' "$input" | "$own" "$@"
  exit $?
fi
exit 0
