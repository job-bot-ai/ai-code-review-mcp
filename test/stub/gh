#!/usr/bin/env bash
# Test stand-in for gh: serves the punch list from $PUNCH_FIXTURE (a folder holding review/...) the way the GitHub
# contents API does (listings with git blob ids, raw files), and fails `pr view`. PUNCH_FAIL=1 fails every call.
set -euo pipefail
[ -z "${PUNCH_FAIL:-}" ] || { echo "stub gh: failing as asked" >&2; exit 1; }
case "${1:-}" in
  auth) echo stub-token; exit 0 ;;
  api) shift ;;
  *) exit 1 ;;
esac
raw=0
[ "${1:-}" = -H ] && { raw=1; shift 2; }
url="$1"; path="${url#repos/*/*/}"; path="${path%%\?*}"
case "$path" in
  commits/main) echo "${PUNCH_REF:-1111111111111111111111111111111111111111}"; exit 0 ;;
  contents/*) rel="${path#contents/}" ;;
  *) echo "stub gh: unexpected $url" >&2; exit 1 ;;
esac
f="$PUNCH_FIXTURE/$rel"
if [ "$raw" = 1 ]; then cat "$f"; exit 0; fi
[ -d "$f" ] || { echo '{"message":"Not Found","status":"404"}'; exit 1; }
for e in "$f"/*; do
  [ -e "$e" ] || continue
  n="$(basename "$e")"
  if [ -d "$e" ]; then jq -cn --arg n "$n" --arg p "$rel/$n" '{name: $n, path: $p, type: "dir", sha: "0"}'
  else jq -cn --arg n "$n" --arg p "$rel/$n" --arg s "$(git hash-object --no-filters "$e")" '{name: $n, path: $p, type: "file", sha: $s}'; fi
done | jq -s .
