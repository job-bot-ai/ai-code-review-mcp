#!/usr/bin/env bash
# review-gate — record/verify per-reviewer "green light" passes bound to the current git HEAD.
# Part of https://github.com/job-bot-ai/ai-code-review-mcp
#
# Flow: open the PR as a draft (`gh pr create --draft` is never gated), let the primary
# reviewers review it, record each clean pass, then `gh pr ready` (gated). A non-draft
# `gh pr create` is gated the same way as `gh pr ready`.
#
# `check` passes for the commit being checked (HEAD, or `--rev <commit>`) when:
#   1. at least REVIEW_GATE_MIN (default 2) DIFFERENT reviewers have a pass recorded for it;
#   2. every primary reviewer has a pass OR an announced skip for it. Primaries default to
#      "kodus coderabbit" until 2026-11-19 and "kodus greptile" from then (UTC); override
#      with REVIEW_GATE_PRIMARY (REVIEW_GATE_REQUIRED is read as a legacy alias);
#   3. a `self` pass only counts when codex also has a pass or a skip (Codex comes first).
# Markers live in $GIT_DIR/review-gate/<reviewer> and are bound to a commit, so adding
# new commits invalidates them (re-review required).
#
# A reviewer that genuinely can't run (not installed on the repo, errored, quota, no review
# within 30 min) is skipped for ONE commit with `record-skip <reviewer> --reason "..."`.
# The skip is stored separately ($GIT_DIR/review-gate/<reviewer>.skip), is announced by
# every `check` that relies on it, and never counts as a pass.
#   4. the commit has a pre-push review: `review-gate prepush` passed for it (no P0-P2 findings), or its
#      findings were declined explicitly with `review-gate prepush-accept --reason "..."` (announced like a skip).
#
# Pre-push review (`prepush [--base <ref>]`): before every push to a PR branch the WHOLE change (`git diff
# <base>...HEAD`) is reviewed against the repo's punch list (review/PUNCH_LIST.md when present) by Codex
# (`codex review -`), or by a read-only `claude -p` when Codex can't run. Only a review that completed (exit 0 and
# either well-formed [P0]-[P3] finding lines or an explicit "No findings.") counts; an error, quota message, empty
# or cut-off answer records nothing. The PreToolUse hook blocks `git push` until HEAD has a `prepush` marker.
# Reviewers: kodus, coderabbit, greptile (primaries), codex (fallback), self (last resort).
# `agy` stays valid for old records. `kimi` (the retired DeepSeek/kimi-review pass) is no longer a
# reviewer: a leftover kimi marker is ignored by `check`/`status` and never counts as a pass.
set -euo pipefail

VALID="kodus coderabbit greptile codex self agy"
MIN="${REVIEW_GATE_MIN:-2}"
case "$MIN" in ''|*[!0-9]*) echo "review-gate: REVIEW_GATE_MIN must be a number" >&2; exit 2;; esac
[ "$MIN" -ge 1 ] || MIN=1
if [ "$(date -u +%Y%m%d)" -ge 20261119 ]; then default_primary="kodus greptile"
else default_primary="kodus coderabbit"; fi
read -r -a PRIMARY <<<"${REVIEW_GATE_PRIMARY:-${REVIEW_GATE_REQUIRED:-$default_primary}}"
# NB: "${arr[@]+"${arr[@]}"}" keeps empty arrays safe under `set -u` on bash < 4.4 (macOS).

gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null)" || {
  echo "review-gate: not inside a git repo" >&2; exit 3; }
head="$(git rev-parse --verify -q HEAD 2>/dev/null || echo none)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)"
if [ "$head" = "none" ]; then
  echo "review-gate: no commits in repository (nothing to gate)" >&2; exit 3
fi
dir="$gitdir/review-gate"

is_valid() { case " $VALID " in *" $1 "*) return 0;; *) return 1;; esac; }
marker()   { printf '%s/%s' "$dir" "$1"; }
recorded() { local m; m="$(marker "$1")"; [ -f "$m" ] && cut -d' ' -f1 <"$m" || true; }
skipped()  { local m; m="$(marker "$1").skip"; [ -f "$m" ] && cut -d' ' -f1 <"$m" || true; }
skip_reason() { cut -d' ' -f4- <"$(marker "$1").skip"; }
# Pre-push marker: "<sha> <branch> <time> <pass|accepted> <base> <reviewer> [reason]" in $dir/prepush.
prepush_rev()  { local m; m="$(marker prepush)"; [ -f "$m" ] && cut -d' ' -f1 <"$m" || true; }
prepush_field() { cut -d' ' -f"$1" <"$(marker prepush)"; }
# Announce an accepted pre-push review (it never reads like a clean pass).
prepush_note() {
  [ "$(prepush_field 4)" = accepted ] || return 0
  echo "review-gate: pre-push review findings for ${1:0:12} were ACCEPTED, not fixed — reason: $(prepush_field 7-) (findings: $dir/prepush-$1.txt)" >&2
}

PROMPT_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/prompts/prepush-review.md"
# Read-only by construction: the diff is already in the prompt, so the fallback gets file reads only. No Bash at all,
# not even `git diff/log/show`: those take --output=<file> and could overwrite the checkout.
# --tools makes them the only built-in tools that exist, --restricted removes every code-running tool,
# --strict-mcp-config (with no --mcp-config) loads no MCP servers, and dontAsk denies anything not allowed.
CLAUDE_REVIEW_TOOLS="Read,Glob,Grep"
CLAUDE_DENIED_TOOLS="Bash,Edit,Write,MultiEdit,NotebookEdit,WebFetch,WebSearch"

# run_limited <seconds> <cmd...>: run with a time limit (exit 124 when it fires). Uses timeout(1); without it
# (stock macOS) a watchdog sends TERM, then KILL, so a stalled reviewer can't hold the lock forever.
run_limited() {
  local t="$1" pid w rc=0; shift
  if command -v timeout >/dev/null 2>&1 && [ -z "${REVIEW_GATE_NO_TIMEOUT:-}" ]; then timeout "$t" "$@"; return; fi
  "$@" <&0 & pid=$!
  ( sleep "$t"; kill -TERM "$pid" 2>/dev/null; sleep 5; kill -KILL "$pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 & w=$!
  wait "$pid" || rc=$?
  kill "$w" 2>/dev/null; wait "$w" 2>/dev/null || true
  [ "$rc" -lt 128 ] || rc=124   # killed by the watchdog (or a signal): not a completed run
  return "$rc"
}

# The verdict part of a Codex run's stdout: after its last "codex" header line if it prints a transcript,
# else all of it (a bare final message).
codex_final_text() {
  awk '
    { l[NR] = $0; h = $0; sub(/[ \t\r]+$/, "", h); if (h == "codex") last = NR }
    END {
      if (!last) { for (i = 1; i <= NR; i++) print l[i]; exit }
      for (i = last + 1; i <= NR; i++) {
        h = l[i]; sub(/[ \t\r]+$/, "", h)
        if (h == "exec" || h == "thinking" || h == "user" || h == "codex" || h == "tokens used") break
        print l[i]
      }
    }' "$1"
}

# classify_tags <file>: each line prefixed with its kind: "G<0-3> " a finding line in the format (`[P1] title`,
# optionally after "- " or "* ", exactly one structural tag), "B " a line with a [Pn] tag we can't read (two tags,
# a tag not at the start, a cut-off `[P1` or stray `P1]`, a tag inside a leading code span), "N " anything else.
# Tags quoted in a code span later in a line (`[P1]` in an explanation) are only quotes. Both parsers below read
# lines through this one function, so a failed run and a completed one can't disagree about what a finding is.
classify_tags() {
  awk '
    { line = $0; sub(/\r$/, "", line)
      tagish = "\\[[Pp][0-3]|[Pp][0-3]\\]"
      if (line ~ /^[ \t]*([-*][ \t]*)?`/ && line ~ tagish) { print "B " line; next }
      t = line; gsub(/`[^`]*`/, "", t)
      n = gsub(/\[[Pp][0-3]\]/, "", t)
      if (t ~ tagish) { print "B " line; next }
      if (n == 0) { print "N " line; next }
      if (n > 1 || line !~ /^[ \t]*([-*][ \t]*)?\[P[0-3]\][ \t]*[^ \t]/) { print "B " line; next }
      match(line, /\[P[0-3]\]/); print "G" substr(line, RSTART + 2, 1) " " line
    }' "$1"
}

# parse_verdict <file>: first line is one of
#   clean | findings <blocking P0-P2> <total> | unreadable <why>
# followed by the finding lines. Strict: every line carrying a [Pn] tag must be one finding in the format;
# otherwise the verdict is unreadable, because a finding we can't read could hide a blocker. "No findings." must
# be the last line, with no P0-P3 mention at all.
parse_verdict() {
  classify_tags "$1" | awk '
    { kind = substr($0, 1, index($0, " ") - 1); line = substr($0, index($0, " ") + 1) }
    kind == "B" { bad[++nb] = line; next }
    kind ~ /^G/ { f[++nf] = line; if (substr(kind, 2) + 0 <= 2) blk++; next }
    { if (line ~ /[^ \t]/) { nonempty++; last = line }
      if (line ~ /(^|[^A-Za-z0-9])[Pp][0-3]([^0-9A-Za-z]|$)/) loose++ }
    END {
      if (nb) { b = bad[1]; if (length(b) > 160) b = substr(b, 1, 160) "..."
        print "unreadable " nb " line(s) carry a [Pn] tag but are not in the finding format, e.g.: " b; exit }
      if (nf) { print "findings " blk + 0 " " nf; for (i = 1; i <= nf; i++) print f[i]; exit }
      v = last; gsub(/^[ \t*_`>]+|[ \t*_`]+$/, "", v)
      if (!nonempty) print "unreadable empty answer"
      else if (v == "No findings." && !loose) print "clean"
      else if (v == "No findings.") print "unreadable \"No findings.\" but the answer mentions a P0-P3 priority"
      else print "unreadable neither [Pn] findings nor a final \"No findings.\""
    }'
}

# One prepush/prepush-accept at a time per worktree: an older run must never publish a pass after a newer run of
# the same commit started (or finished with findings). With flock(1) the kernel holds the lock for the life of
# the process (released however it ends, so there is no stale lock to take over). Without flock (macOS), a
# symlink whose target is the owner's pid is created atomically (`ln -s` fails if it exists, and the pid is never
# missing); a link whose owner is gone is taken over, best effort.
LOCK=""; WORK=""
take_lock() {
  mkdir -p "$dir"
  if command -v flock >/dev/null 2>&1 && [ -z "${REVIEW_GATE_NO_FLOCK:-}" ]; then
    exec 9>>"$dir/prepush.lock"
    flock -n 9 || { echo "review-gate: another prepush/prepush-accept is running in this worktree; wait for it" >&2; exit 5; }
    return 0
  fi
  local l="$dir/prepush.lock.pid" t="$dir/prepush.lock.takeover" pid
  if ! ln -s "$$" "$l" 2>/dev/null; then
    # Taking over a dead owner's link is itself serialized (atomic mkdir), and the link is re-read inside, so a
    # second taker can never remove the link the first one just created.
    mkdir "$t" 2>/dev/null || { echo "review-gate: another prepush is taking over the lock in this worktree; retry (a $t left by a crash can be removed)" >&2; exit 5; }
    pid="$(readlink "$l" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      rmdir "$t"; echo "review-gate: another prepush/prepush-accept (pid $pid) is running in this worktree; wait for it" >&2; exit 5
    fi
    rm -f "$l"
    if ! ln -s "$$" "$l" 2>/dev/null; then rmdir "$t"; echo "review-gate: couldn't take $l; retry" >&2; exit 5; fi
    rmdir "$t"
  fi
  LOCK="$l"
}
cleanup() {
  [ -z "$WORK" ] || rm -rf "$WORK"
  if [ -n "$LOCK" ] && [ "$(readlink "$LOCK" 2>/dev/null)" = "$$" ]; then rm -f "$LOCK"; fi   # only our own lock
}
trap cleanup EXIT

# The base to review against: the PR base if gh can tell, else origin/main.
default_base() {
  local b
  b="$(run_limited 20 "${REVIEW_GATE_GH:-gh}" pr view --json baseRefName -q .baseRefName 2>/dev/null </dev/null || true)"
  case "$b" in ''|*[!A-Za-z0-9._/-]*) b="";; esac
  if [ -n "$b" ]; then
    GIT_TERMINAL_PROMPT=0 run_limited 60 git fetch -q origin "$b" >/dev/null 2>&1 </dev/null || true
    if git rev-parse --verify -q "refs/remotes/origin/$b^{commit}" >/dev/null; then echo "origin/$b"; return; fi
  fi
  echo "origin/main"
}

case "${1:-help}" in
  record)
    r="${2:-}"
    is_valid "$r" || { echo "review-gate: unknown reviewer '$r' (valid: $VALID)" >&2; exit 2; }
    rev="$head"
    if [ "${3:-}" = "--rev" ]; then   # the exact commit that was reviewed
      rev="$(git rev-parse --verify -q "${4:-}^{commit}" 2>/dev/null)" || {
        echo "review-gate: --rev '${4:-}' is not a commit" >&2; exit 2; }
    fi
    mkdir -p "$dir"
    printf '%s %s %s\n' "$rev" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$(marker "$r")"
    echo "review-gate: recorded $r pass for $branch @ ${rev:0:12}"
    ;;
  record-skip)
    r="${2:-}"
    is_valid "$r" || { echo "review-gate: unknown reviewer '$r' (valid: $VALID)" >&2; exit 2; }
    [ "${3:-}" = "--reason" ] || { echo "review-gate: usage: record-skip <reviewer> --reason \"why it can't run\"" >&2; exit 2; }
    reason="$(printf '%s' "${4:-}" | tr '\n\r' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ "${#reason}" -ge 10 ] || { echo "review-gate: --reason must say why $r can't run (10+ characters)" >&2; exit 2; }
    mkdir -p "$dir"
    printf '%s %s %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" >"$(marker "$r").skip"
    echo "review-gate: recorded SKIP of $r for $branch @ ${head:0:12} — $reason"
    echo "review-gate: every gate check on this commit will announce the skip; a real pass still needs another reviewer"
    ;;
  check)
    rev="$head"
    if [ "${2:-}" = "--rev" ]; then
      rev="$(git rev-parse --verify -q "${3:-}^{commit}" 2>/dev/null)" || {
        echo "review-gate: --rev '${3:-}' is not a commit" >&2; exit 1; }
    fi
    for r in ${PRIMARY[@]+"${PRIMARY[@]}"}; do
      is_valid "$r" || { echo "review-gate: unknown primary reviewer '$r' (valid: $VALID)" >&2; exit 1; }
    done
    passes=(); skips=(); problems=()
    for r in $VALID; do
      if [ "$(recorded "$r")" = "$rev" ]; then passes+=("$r")
      elif [ "$(skipped "$r")" = "$rev" ]; then skips+=("$r"); fi
    done
    has() { local x="$1"; shift; case " $* " in *" $x "*) return 0;; *) return 1;; esac; }
    for r in ${skips[@]+"${skips[@]}"}; do
      echo "review-gate: $r was SKIPPED for ${rev:0:12} — reason: $(skip_reason "$r")" >&2
    done
    # A self-review is the last resort: it only counts once Codex passed or was skipped.
    # An ineligible self pass is simply not counted; it is only reported when the gate fails.
    counted=(); self_ignored=0
    for r in ${passes[@]+"${passes[@]}"}; do
      if [ "$r" = self ] && ! has codex ${passes[@]+"${passes[@]}"} ${skips[@]+"${skips[@]}"}; then
        self_ignored=1
        continue
      fi
      counted+=("$r")
    done
    for r in ${PRIMARY[@]+"${PRIMARY[@]}"}; do
      has "$r" ${passes[@]+"${passes[@]}"} ${skips[@]+"${skips[@]}"} ||
        problems+=("primary reviewer $r has no pass or skip")
    done
    # Nothing reaches "ready" without a pre-push review of that exact commit (passed, or findings accepted).
    if [ "$(prepush_rev)" = "$rev" ]; then prepush_note "$rev"
    else problems+=("no pre-push review for this commit (review-gate prepush)"); fi
    if [ "${#counted[@]}" -lt "$MIN" ]; then
      problems+=("${#counted[@]} of $MIN review passes (${counted[*]:-none})")
      [ "$self_ignored" = 1 ] &&
        problems+=("a self review only counts after codex has a pass or a skip (record-skip codex --reason ...)")
    fi
    if [ "${#problems[@]}" -gt 0 ]; then
      echo "missing/stale review pass for ${rev:0:12}: $(IFS=';'; printf '%s' "${problems[*]}" | sed 's/;/; /g')" >&2
      exit 1
    fi
    exit 0
    ;;
  status)
    printf 'HEAD: %s (%s)\n' "$head" "$branch"
    for r in $VALID; do
      rh="$(recorded "$r")"; sh="$(skipped "$r")"
      if [ -n "$rh" ] && [ "$rh" = "$head" ]; then s="green @ ${rh:0:12}"
      elif [ -n "$sh" ] && [ "$sh" = "$head" ]; then s="SKIPPED @ ${sh:0:12} — $(skip_reason "$r")"
      elif [ -n "$rh" ]; then s="STALE @ ${rh:0:12}"
      elif [ -n "$sh" ]; then s="STALE skip @ ${sh:0:12}"
      else s="(none)"; fi
      req=""; case " ${PRIMARY[*]-} " in *" $r "*) req=" [primary]";; esac
      printf '  %-11s %s%s\n' "$r" "$s" "$req"
    done
    ph="$(prepush_rev)"
    if [ -n "$ph" ] && [ "$ph" = "$head" ]; then
      if [ "$(prepush_field 4)" = accepted ]; then s="ACCEPTED @ ${ph:0:12} ($(prepush_field 6) vs $(prepush_field 5)) — $(prepush_field 7-)"
      else s="green @ ${ph:0:12} ($(prepush_field 6) vs $(prepush_field 5))"; fi
    elif [ -n "$ph" ]; then s="STALE @ ${ph:0:12}"
    else s="(none)"; fi
    res="$dir/prepush-$head.result"
    if [ "$s" = "(none)" ] || [ "${s#STALE}" != "$s" ]; then
      if [ -f "$res" ]; then
        read -r rs rb rt _ <"$res" || true
        if [ "$rs" = completed ]; then s="$s; last run for HEAD: $rb P0-P2 of $rt findings (fix them, or prepush-accept)"
        else s="$s; last run for HEAD FAILED: $(cut -d' ' -f2- <"$res")"; fi
      fi
    fi
    printf '  %-11s %s [required before push]\n' prepush "$s"
    ;;
  clear)
    if [ "${2:-}" = prepush ]; then
      rm -f "$(marker prepush)"; echo "review-gate: cleared prepush"
    elif [ -n "${2:-}" ]; then
      is_valid "$2" || { echo "review-gate: unknown reviewer '$2' (valid: $VALID)" >&2; exit 2; }
      rm -f "$(marker "$2")" "$(marker "$2").skip"; echo "review-gate: cleared $2"
    else
      rm -rf "$dir"; echo "review-gate: cleared all"
    fi
    ;;
  check-prepush)   # used by the hook before `git push`: does the commit have a pre-push review?
    rev="$head"
    if [ "${2:-}" = "--rev" ]; then
      rev="$(git rev-parse --verify -q "${3:-}^{commit}" 2>/dev/null)" || {
        echo "review-gate: --rev '${3:-}' is not a commit" >&2; exit 1; }
    fi
    if [ "$(prepush_rev)" = "$rev" ]; then prepush_note "$rev"; exit 0; fi
    msg="no pre-push review for ${rev:0:12}"
    res="$dir/prepush-$rev.result"
    if [ -f "$res" ]; then
      read -r rs rb rt _ <"$res" || true
      if [ "$rs" = completed ]; then msg="$msg: the last review found $rb P0-P2 finding(s) (of $rt), see $dir/prepush-$rev.txt"
      else msg="$msg: the last review FAILED ($(cut -d' ' -f2- <"$res"))"; fi
    fi
    echo "$msg" >&2
    exit 1
    ;;
  prepush)
    shift; base=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --base) [ -n "${2:-}" ] || { echo "review-gate: --base needs a ref" >&2; exit 2; }; base="$2"; shift 2 ;;
        --base=*) base="${1#--base=}"; shift ;;
        *) echo "review-gate: usage: prepush [--base <ref>]" >&2; exit 2 ;;
      esac
    done
    [ -n "$base" ] || base="$(default_base)"
    base_sha="$(git rev-parse --verify -q "$base^{commit}" 2>/dev/null)" || {
      echo "review-gate: base '$base' is not a commit here (fetch it, or pass --base <ref>)" >&2; exit 2; }
    mb="$(git merge-base "$base_sha" "$head" 2>/dev/null)" || {
      echo "review-gate: $base and HEAD have no common history" >&2; exit 2; }
    [ -r "$PROMPT_FILE" ] || { echo "review-gate: prompt file $PROMPT_FILE is missing" >&2; exit 2; }
    command -v jq >/dev/null 2>&1 || { echo "review-gate: jq is required for prepush" >&2; exit 2; }
    take_lock
    out="$dir/prepush-$head.txt"; res="$dir/prepush-$head.result"
    # A new review of this commit replaces the old one: its pass (or acceptance) no longer stands until this run
    # completes clean, so a later run's findings can't hide behind an earlier pass.
    [ "$(prepush_rev)" = "$head" ] && rm -f "$(marker prepush)"
    printf 'failed review in progress (started %s)\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$res"
    work="$(mktemp -d)"; WORK="$work"
    # The reviewed commit is fixed now: a commit made while the review runs doesn't get this review.
    git diff "$mb" "$head" >"$work/diff"
    if [ ! -s "$work/diff" ]; then
      echo "review-gate: no changes between $base and ${head:0:12}: nothing to review (is --base the PR's base?)" >&2
      printf 'failed no changes against %s\n' "$base" >"$res"; exit 4
    fi
    max="${REVIEW_GATE_PREPUSH_MAX_DIFF:-600000}"
    if [ "$(wc -c <"$work/diff")" -gt "$max" ]; then
      echo "review-gate: the diff against $base is over $max bytes; a partial review is no review. Split the change." >&2
      printf 'failed diff over %s bytes\n' "$max" >"$res"; exit 4
    fi
    # Prompt: instructions, the punch list (if the repo has one), then the diff in a fence it can't close.
    fence='```'; while grep -qF -- "$fence" "$work/diff"; do fence="$fence\`"; done
    top="$(git rev-parse --show-toplevel)"
    {
      cat "$PROMPT_FILE"
      printf '\nThe change: `git diff %s...%s` (base %s).\n' "$base" "${head:0:12}" "${mb:0:12}"
      if [ -f "$top/review/PUNCH_LIST.md" ]; then
        printf '\n## Punch list (review/PUNCH_LIST.md): check every item\n\n'; cat "$top/review/PUNCH_LIST.md"
      else
        printf '\n(No review/PUNCH_LIST.md in this repo.)\n'
      fi
      printf '\n## Diff\n\n%sdiff\n' "$fence"; cat "$work/diff"; printf '%s\n' "$fence"
    } >"$work/prompt"
    tmo="${REVIEW_GATE_PREPUSH_TIMEOUT:-1500}"
    case "$tmo" in ''|*[!0-9]*) echo "review-gate: REVIEW_GATE_PREPUSH_TIMEOUT must be seconds" >&2; exit 2;; esac
    reviewer=""; verdict=""; why=""
    {
      printf 'review-gate prepush: %s @ %s vs %s (%s), %s\n' "$branch" "$head" "$base" "$mb" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$out"
    # 1. Codex. Prompt mode (`codex review -`): `--base` can't carry the punch list or the answer format.
    echo "review-gate: reviewing ${head:0:12} vs $base with Codex (time limit ${tmo}s)..." >&2
    rc=0; (cd "$top" && run_limited "$tmo" codex review -c 'sandbox_mode="read-only"' - <"$work/prompt" >"$work/co" 2>"$work/ce") || rc=$?
    { printf '\n===== codex review (exit %s): stdout =====\n' "$rc"; cat "$work/co"; printf '\n===== codex stderr =====\n'; cat "$work/ce"; } >>"$out"
    codex_err="$(grep -h -E '^ERROR:' "$work/co" "$work/ce" | head -n 1 | cut -c1-200 || true)"
    codex_final_text "$work/co" >"$work/cv"
    if [ "$rc" -ne 0 ]; then why="codex exited $rc"
    elif [ -n "$codex_err" ]; then why="codex reported: $codex_err"
    elif ! grep -q '[^[:space:]]' "$work/cv"; then why="codex printed no final message"
    fi
    # Findings Codex did print stay findings even when the run failed: an error never hides a blocker.
    codex_partial=""; codex_unread=""
    if [ -n "$why" ]; then
      # Every well-formed finding line, whatever else the answer holds (a truncated or malformed line after a
      # good finding must not discard it); a tagged line we can't read means a finding could be lost.
      codex_partial="$(classify_tags "$work/cv" | sed -n 's/^G[0-3] //p')"
      codex_unread="$(classify_tags "$work/cv" | sed -n 's/^B //p' | head -n 1 | cut -c1-160)"
      echo "review-gate: Codex can't review ($why); falling back to a read-only Claude review..." >&2
      if ! command -v claude >/dev/null 2>&1; then
        verdict="unreadable"; why="$why; claude is not installed"
      else
        rc=0
        (cd "$top" && run_limited "$tmo" claude -p --output-format json --max-turns 40 --no-session-persistence \
          --restricted --strict-mcp-config --tools "$CLAUDE_REVIEW_TOOLS" \
          --permission-mode dontAsk --allowedTools "$CLAUDE_REVIEW_TOOLS" \
          --disallowedTools "$CLAUDE_DENIED_TOOLS" <"$work/prompt" >"$work/lo" 2>"$work/le") || rc=$?
        { printf '\n===== claude -p (exit %s): stdout =====\n' "$rc"; cat "$work/lo"; printf '\n===== claude stderr =====\n'; cat "$work/le"; } >>"$out"
        jq -r 'if .is_error == false and .subtype == "success" and (.result | type) == "string" then .result else empty end' \
          <"$work/lo" >"$work/cv" 2>/dev/null || : >"$work/cv"
        if [ "$rc" -ne 0 ]; then why="$why; claude exited $rc"
        elif ! grep -q '[^[:space:]]' "$work/cv"; then why="$why; claude gave no successful result (error, max turns or no answer)"
        else why=""; reviewer=claude; fi
      fi
    else
      reviewer=codex
    fi
    # Codex failed after printing a [Pn] line we can't read: a finding may be lost, so no fallback can clear it.
    [ -z "$why" ] && [ -n "$codex_unread" ] && why="Codex failed after printing a [Pn] line not in the finding format: $codex_unread"
    if [ -n "$why" ]; then
      {
        echo "review-gate: pre-push review FAILED for ${head:0:12}: $why"
        echo "  Nothing was recorded. Full output: $out"
        [ -z "$codex_partial" ] || { echo "  Codex printed these findings before failing (fix them too):"; printf '%s\n' "$codex_partial" | sed 's/^/    /'; }
        echo "  Run \`review-gate prepush\` again once a reviewer can run (Codex usage limits reset; Claude needs a login)."
      } >&2
      printf 'failed %s\n' "$why" >"$res"; exit 4
    fi
    parse_verdict "$work/cv" >"$work/pv"
    read -r kind nblk ntot _ <"$work/pv" || true
    { printf '\n===== verdict (%s) =====\n' "$reviewer"; cat "$work/pv"; } >>"$out"
    if [ -n "$codex_partial" ] && { [ "$kind" = clean ] || [ "$kind" = findings ]; }; then
      # Codex's findings from a failed run count against the commit too: an error never hides a blocker.
      [ "$kind" = findings ] || { kind=findings; nblk=0; ntot=0; : >"$work/pv"; }
      tail -n +2 "$work/pv" >"$work/pf" 2>/dev/null || :
      printf '%s\n' "$codex_partial" >>"$work/pf"
      nblk=$((nblk + $(printf '%s\n' "$codex_partial" | grep -cE '\[P[0-2]\]' || true)))
      ntot=$((ntot + $(printf '%s\n' "$codex_partial" | grep -c . || true)))
      { echo "findings $nblk $ntot"; cat "$work/pf"; } >"$work/pv"
    fi
    case "$kind" in
      clean)
        printf 'completed 0 0 %s %s\n' "$reviewer" "$base" >"$res"
        printf '%s %s %s pass %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$base" "$reviewer" >"$(marker prepush)"
        echo "review-gate: pre-push review ($reviewer vs $base): No findings. Recorded prepush pass for $branch @ ${head:0:12}"
        exit 0 ;;
      findings)
        printf 'completed %s %s %s %s\n' "$nblk" "$ntot" "$reviewer" "$base" >"$res"
        echo "review-gate: pre-push review ($reviewer vs $base) of ${head:0:12}: $ntot finding(s), $nblk of them P0-P2:"
        tail -n +2 "$work/pv" | sed 's/^[[:space:]]*/  /'
        echo "  Full review: $out"
        if [ "$nblk" -eq 0 ]; then
          printf '%s %s %s pass %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$base" "$reviewer" >"$(marker prepush)"
          echo "review-gate: only P3 findings: recorded prepush pass for $branch @ ${head:0:12} (fix the nits if cheap)"
          exit 0
        fi
        {
          echo "review-gate: NOT recorded: fix the P0-P2 findings, commit, and run \`review-gate prepush\` again."
          echo "  A finding you decide not to fix: decline it explicitly, for this commit only:"
          echo "    review-gate prepush-accept --reason \"why each P0-P2 finding above is not being fixed\""
          echo "  (every later check of this commit announces the accepted findings and the reason)"
        } >&2
        exit 1 ;;
      *)
        why="$reviewer's answer is unreadable: $(cut -d' ' -f2- <"$work/pv")"
        printf 'failed %s\n' "$why" >"$res"
        {
          echo "review-gate: pre-push review FAILED for ${head:0:12}: $why. Nothing was recorded. Full output: $out"
          [ -z "$codex_partial" ] || { echo "  Codex printed these findings before failing (fix them too):"; printf '%s\n' "$codex_partial" | sed 's/^/    /'; }
        } >&2
        exit 4 ;;
    esac
    ;;
  prepush-accept)
    [ "${2:-}" = "--reason" ] || { echo "review-gate: usage: prepush-accept --reason \"why the P0-P2 findings are not being fixed\"" >&2; exit 2; }
    reason="$(printf '%s' "${3:-}" | tr '\n\r' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ "${#reason}" -ge 10 ] || { echo "review-gate: --reason must say why each finding is not being fixed (10+ characters)" >&2; exit 2; }
    take_lock
    res="$dir/prepush-$head.result"
    [ -f "$res" ] || { echo "review-gate: no pre-push review of ${head:0:12} to accept; run \`review-gate prepush\` first" >&2; exit 2; }
    read -r rs rb rt rr rbase _ <"$res" || true
    if [ "$rs" != completed ]; then
      echo "review-gate: the last pre-push review of ${head:0:12} did not complete ($(cut -d' ' -f2- <"$res")): a failed review can't be accepted. Run \`review-gate prepush\` again." >&2
      exit 2
    fi
    [ "${rb:-0}" -gt 0 ] || { echo "review-gate: that review had no P0-P2 findings; nothing to accept" >&2; exit 2; }
    printf '%s %s %s accepted %s %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rbase" "$rr" "$reason" >"$(marker prepush)"
    echo "review-gate: recorded ACCEPTED pre-push findings ($rb P0-P2 of $rt, $rr vs $rbase) for $branch @ ${head:0:12} — $reason"
    echo "review-gate: every check of this commit will announce it; findings: $dir/prepush-$head.txt"
    ;;
  *)
    {
      echo "usage: review-gate {record <reviewer> [--rev <commit>]|record-skip <reviewer> --reason \"...\"|check [--rev <commit>]|status|clear [reviewer|prepush]}"
      echo "       review-gate {prepush [--base <ref>]|prepush-accept --reason \"...\"|check-prepush [--rev <commit>]}"
      echo "  reviewers: $VALID"
      echo "  primary  : ${PRIMARY[*]-}  (override with REVIEW_GATE_PRIMARY=\"kodus coderabbit\")"
      echo "  passes   : $MIN different reviewers (REVIEW_GATE_MIN); self counts only after codex passed or was skipped"
      echo "  prepush  : a pre-push review of the commit (passed, or findings accepted) is required by check and before git push"
    } >&2
    exit 2
    ;;
esac
