#!/usr/bin/env bash
# review-gate — record/verify per-reviewer "green light" passes bound to the current git HEAD.
# Part of https://github.com/job-bot-ai/ai-code-review-mcp
#
# `check` passes only when EVERY required reviewer has a pass recorded for the commit being
# checked (HEAD, or `--rev <commit>`). Required reviewers default to "coderabbit codex";
# override via REVIEW_GATE_REQUIRED.
# Markers live in $GIT_DIR/review-gate/<reviewer> and are bound to a commit, so adding
# new commits invalidates them (re-review required).
#
# A reviewer that genuinely can't run (quota, outage) can be skipped for ONE commit with
# `record-skip <reviewer> --reason "..."`. The skip is stored separately
# ($GIT_DIR/review-gate/<reviewer>.skip), is announced by every `check` that relies on it,
# and never satisfies the gate on its own: at least one real pass is required.
# `agy` (Google Antigravity) is an optional fallback reviewer: never required by default,
# but its pass counts as that real pass, e.g. when CodeRabbit AND Codex are both skipped.
set -euo pipefail

VALID="coderabbit codex agy"
read -r -a REQUIRED <<<"${REVIEW_GATE_REQUIRED:-coderabbit codex}"
# NB: "${arr[@]+"${arr[@]}"}" keeps empty arrays safe under `set -u` on bash < 4.4 (macOS).

gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null)" || {
  echo "review-gate: not inside a git repo" >&2; exit 3; }
head="$(git rev-parse --verify -q HEAD 2>/dev/null || echo none)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)"
if [ "$head" = "none" ]; then
  echo "review-gate: no commits in repository (nothing to gate)" >&2; exit 3
fi
dir="$gitdir/review-gate"

is_valid() { case " $VALID " in *" $1 "*) return 0;; *) return 1;; esac; }
marker()   { printf '%s/%s' "$dir" "$1"; }
recorded() { local m; m="$(marker "$1")"; [ -f "$m" ] && cut -d' ' -f1 <"$m" || true; }
skipped()  { local m; m="$(marker "$1").skip"; [ -f "$m" ] && cut -d' ' -f1 <"$m" || true; }
skip_reason() { cut -d' ' -f4- <"$(marker "$1").skip"; }

case "${1:-help}" in
  record)
    r="${2:-}"
    is_valid "$r" || { echo "review-gate: unknown reviewer '$r' (valid: $VALID)" >&2; exit 2; }
    mkdir -p "$dir"
    printf '%s %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$(marker "$r")"
    echo "review-gate: recorded $r pass for $branch @ ${head:0:12}"
    ;;
  record-skip)
    r="${2:-}"
    is_valid "$r" || { echo "review-gate: unknown reviewer '$r' (valid: $VALID)" >&2; exit 2; }
    [ "${3:-}" = "--reason" ] || { echo "review-gate: usage: record-skip <reviewer> --reason \"why it can't run\"" >&2; exit 2; }
    reason="$(printf '%s' "${4:-}" | tr '\n\r' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ "${#reason}" -ge 10 ] || { echo "review-gate: --reason must say why $r can't run (10+ characters)" >&2; exit 2; }
    mkdir -p "$dir"
    printf '%s %s %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" >"$(marker "$r").skip"
    echo "review-gate: recorded SKIP of $r for $branch @ ${head:0:12} — $reason"
    echo "review-gate: every gate check on this commit will announce the skip; a real pass still needs another reviewer"
    ;;
  check)
    rev="$head"
    if [ "${2:-}" = "--rev" ]; then
      rev="$(git rev-parse --verify -q "${3:-}^{commit}" 2>/dev/null)" || {
        echo "review-gate: --rev '${3:-}' is not a commit" >&2; exit 1; }
    fi
    if [ "${#REQUIRED[@]}" -eq 0 ]; then
      echo "REVIEW_GATE_REQUIRED is set but names no reviewers (valid: $VALID)" >&2; exit 1
    fi
    missing=(); skips=(); passes=0
    for r in "${REQUIRED[@]}"; do
      if [ "$(recorded "$r")" = "$rev" ]; then
        passes=$((passes + 1))
      elif [ "$(skipped "$r")" = "$rev" ]; then
        skips+=("$r")
      else
        missing+=("$r")
      fi
    done
    for r in ${skips[@]+"${skips[@]}"}; do
      echo "review-gate: $r was SKIPPED for ${rev:0:12} — reason: $(skip_reason "$r")" >&2
    done
    if [ "${#missing[@]}" -gt 0 ]; then
      echo "missing/stale review pass for ${rev:0:12}: ${missing[*]}" >&2
      exit 1
    fi
    if [ "$passes" -eq 0 ]; then
      case " ${REQUIRED[*]} " in *" agy "*) ;; *)
        if [ "$(recorded agy)" = "$rev" ]; then
          echo "review-gate: required reviewers were skipped for ${rev:0:12}; the agy review is the real pass" >&2
          exit 0
        fi ;;
      esac
      echo "every required reviewer was skipped for ${rev:0:12}; at least one real review pass is required (coderabbit, codex or agy)" >&2
      exit 1
    fi
    exit 0
    ;;
  status)
    printf 'HEAD: %s (%s)\n' "$head" "$branch"
    for r in $VALID; do
      rh="$(recorded "$r")"; sh="$(skipped "$r")"
      if [ -n "$rh" ] && [ "$rh" = "$head" ]; then s="green @ ${rh:0:12}"
      elif [ -n "$sh" ] && [ "$sh" = "$head" ]; then s="SKIPPED @ ${sh:0:12} — $(skip_reason "$r")"
      elif [ -n "$rh" ]; then s="STALE @ ${rh:0:12}"
      elif [ -n "$sh" ]; then s="STALE skip @ ${sh:0:12}"
      else s="(none)"; fi
      req=""; case " ${REQUIRED[*]-} " in *" $r "*) req=" [required]";; esac
      printf '  %-11s %s%s\n' "$r" "$s" "$req"
    done
    ;;
  clear)
    if [ -n "${2:-}" ]; then
      is_valid "$2" || { echo "review-gate: unknown reviewer '$2' (valid: $VALID)" >&2; exit 2; }
      rm -f "$(marker "$2")" "$(marker "$2").skip"; echo "review-gate: cleared $2"
    else
      rm -rf "$dir"; echo "review-gate: cleared all"
    fi
    ;;
  *)
    {
      echo "usage: review-gate {record <reviewer>|record-skip <reviewer> --reason \"...\"|check [--rev <commit>]|status|clear [reviewer]}"
      echo "  reviewers: $VALID"
      echo "  required : ${REQUIRED[*]-}  (override with REVIEW_GATE_REQUIRED=\"coderabbit codex\")"
    } >&2
    exit 2
    ;;
esac
