#!/usr/bin/env bash
# coderabbit-gate — record / verify a CodeRabbit "green light" tied to the current git HEAD.
# Part of https://github.com/job-bot-ai/CodeRabbit-Claude-MCP
#
# The pass is recorded per-repo in $GIT_DIR/coderabbit-gate-pass and is bound to a
# specific HEAD commit, so adding new commits invalidates it (re-review required).
set -euo pipefail

gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null)" || {
  echo "coderabbit-gate: not inside a git repo" >&2; exit 3; }
marker="$gitdir/coderabbit-gate-pass"
head="$(git rev-parse --verify -q HEAD 2>/dev/null || echo none)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)"

# No commits yet → nothing a PR could be built from. Refuse so an empty repo can't
# record/match a "none" pass and slip through the gate.
if [ "$head" = "none" ]; then
  echo "coderabbit-gate: no commits in repository (nothing to gate)" >&2
  exit 3
fi

case "${1:-help}" in
  record|pass)
    printf '%s %s %s\n' "$head" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$marker"
    echo "coderabbit-gate: recorded pass for $branch @ ${head:0:12}"
    ;;
  check)
    [ -f "$marker" ] || { echo "no CodeRabbit pass recorded for this repo" >&2; exit 1; }
    recorded="$(cut -d' ' -f1 < "$marker" 2>/dev/null || true)"
    if [ "$recorded" = "$head" ]; then
      exit 0
    else
      echo "recorded pass is for ${recorded:0:12}, but HEAD is ${head:0:12} (stale — re-review needed)" >&2
      exit 1
    fi
    ;;
  status)
    if [ -f "$marker" ]; then printf 'recorded: %s\n' "$(cat "$marker")"; else echo "recorded: (none)"; fi
    printf 'HEAD:     %s (%s)\n' "$head" "$branch"
    ;;
  clear)
    rm -f "$marker"; echo "coderabbit-gate: cleared"
    ;;
  *)
    {
      echo "usage: coderabbit-gate {record|check|status|clear}"
      echo "  record  mark the current HEAD as having passed CodeRabbit review"
      echo "  check   exit 0 if the current HEAD has a recorded pass, else 1"
      echo "  status  show the recorded pass vs the current HEAD"
      echo "  clear   remove the recorded pass"
    } >&2
    exit 2
    ;;
esac
